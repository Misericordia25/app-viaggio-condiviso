rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function member(g) { return signed() && request.auth.uid in get(/databases/$(db)/documents/gruppi/$(g)).data.membri; }
    match /users/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid;
    }
    match /gruppi/{g} {
      allow get: if signed();
      allow create: if signed() && request.resource.data.membri == [request.auth.uid];
      allow update: if member(g) || (signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membri'])
        && request.resource.data.membri.size() == resource.data.membri.size() + 1
        && request.resource.data.membri.hasAll(resource.data.membri)
        && request.auth.uid in request.resource.data.membri
        && request.resource.data.membri.size() <= 5);
      allow delete: if false;
      match /{sub=**} { allow read, write: if member(g); }
    }
  }
}
